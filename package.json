{
  "name": "sidedoor",
  "version": "1.0.0",
  "description": "Sidedoor: a local-first webhook inspector, API mock server, and realtime protocol test harness.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ryan-mf-eloy/sidedoor.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "sidedoor": "src/server.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "graphql": "^16.14.2",
    "graphql-ws": "^6.2.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
