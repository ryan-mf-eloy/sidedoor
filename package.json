{
  "name": "sidedoor",
  "version": "1.0.0",
  "description": "Local-first webhook inspector + API mock server with Tailscale Funnel. Zero dependencies.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "sidedoor": "src/server.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {},
  "devDependencies": {}
}
